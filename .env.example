# ---------------------------------------------------------------------------
# OwnerRez — pricing, availability, and saved quotes
# ---------------------------------------------------------------------------
# Personal Access Token: OwnerRez -> Settings -> API -> Personal Access Tokens.
OWNERREZ_TOKEN=
# The OwnerRez login the token belongs to. Defaults to lisa@bellabeachrentals.com.
OWNERREZ_USERNAME=

# ---------------------------------------------------------------------------
# Outlook mailbox — reading Beachcombers NW inquiries and replying to guests
# ---------------------------------------------------------------------------
# Azure app registration (portal.azure.com -> App registrations).
MS_CLIENT_ID=

# Delegated auth (recommended — works for both outlook.com and Microsoft 365).
# Get this once by running:  npm run outlook:auth -- <application id>
MS_REFRESH_TOKEN=

# Only for Microsoft 365 app-only auth instead of the refresh token above.
# Needs Mail.ReadWrite + Mail.Send *application* permissions and admin consent.
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=

# ---------------------------------------------------------------------------
# The inquiry job itself
# ---------------------------------------------------------------------------
# Shared secret protecting /api/inquiries/*. Generate with: openssl rand -hex 32
INQUIRY_JOB_SECRET=

# Set to "false" to make every reply a draft instead of sending it.
INQUIRY_AUTO_SEND=true

# The "source" OwnerRez attaches to a public booking link (a number from the
# link it generates, e.g. channel=792959482). Optional.
OWNERREZ_BOOKING_CHANNEL=

# Sending domain of the directory that forwards inquiries.
BEACHCOMBERS_SENDER_DOMAIN=beachcombersnw.com

# How far back to look for unread inquiries on each run.
INQUIRY_LOOKBACK_DAYS=3
